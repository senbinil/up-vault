DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/up_vault_test
DATABASE_ADMIN_URL=postgresql+psycopg://username:password@localhost:5432/postgres

# Set EMBEDDING_PROVIDER=dummy to avoid needing an external server.
# Requires a running Infinity server at EMBEDDING_BASE_URL.
EMBEDDING_PROVIDER=dummy
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BASE_URL=http://localhost:7997
EMBEDDING_TIMEOUT_SECONDS=30
